# SafeDep — LLM Provider API Keys
# Copy this file to .env and fill in your keys.
# SafeDep checks these in priority order:
#   1. GROQ_API_KEY   → Groq (llama-3.3-70b-versatile) — fastest, free tier available
#   2. DEEPSEEK_API_KEY → DeepSeek (deepseek-chat)
#   3. (neither)      → Built-in offline AST refactoring engine (no key needed)

# Option A: Groq  — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Option B: DeepSeek  — https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk_your_deepseek_api_key_here

